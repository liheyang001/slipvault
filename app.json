{
  "expo": {
    "name": "Vesta",
    "slug": "InvoiceReader",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/2acb2ded-2f3e-48c3-920d-df1ef7090c8f"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nz.co.vesta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Vesta uses the camera to photograph invoices for recognition.",
        "NSPhotoLibraryUsageDescription": "Vesta accesses your photos to import invoice images.",
        "NSPhotoLibraryAddUsageDescription": "Vesta saves invoice photos to your library."
      }
    },
    "android": {
      "package": "nz.co.vesta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563eb"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vesta uses the camera to photograph invoices for recognition."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vesta accesses your photos to import invoice images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vesta saves invoice photos to your library."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "privacyPolicyUrl": "https://invoice-reader-privacy.pages.dev/privacy-policy.html",
      "eas": {
        "projectId": "2acb2ded-2f3e-48c3-920d-df1ef7090c8f"
      }
    }
  }
}
