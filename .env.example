# 部署 worker/ 目录下的 Cloudflare Worker 后，将 Worker URL 填入此处
# 格式: https://invoice-reader-proxy.<your-subdomain>.workers.dev
EXPO_PUBLIC_AI_PROXY_URL=https://your-worker.workers.dev

# Google Cloud Console > APIs & Services > Credentials > the "Web application"
# OAuth client (not the Android one) — used as the audience for Google Sign-In
# ID tokens. Format: xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Shared secret matching the Worker's APP_SECRET (set it there with
# `wrangler secret put APP_SECRET`). Light abuse protection: when the Worker
# has APP_SECRET set, every request must carry this value as the X-App-Key
# header, and the dev credit top-up action requires it unconditionally.
EXPO_PUBLIC_APP_KEY=a-long-random-hex-string
